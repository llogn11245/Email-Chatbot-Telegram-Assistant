# Bot token và API key LLM KHÔNG cấu hình ở đây — nhập qua web control panel
# và được lưu (mã hoá) trong PostgreSQL.

# Khoá mã hoá dữ liệu nhạy cảm. Đổi ngay, nếu không sẽ không giải mã được dữ liệu cũ:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-me

# Chỉ cho phép 1 chat_id dùng bot (tuỳ chọn, khuyến nghị). Để trống = ai cũng dùng được.
TELEGRAM_ADMIN_ID=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8000
# URL user mở để vào control panel (đổi khi deploy không phải localhost)
WEB_URL=http://localhost:8000

# RUN_MODE = both | bot | web
RUN_MODE=both
